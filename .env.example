# Supabase（服务器端专用；切勿把 service role 或 anon key 加 NEXT_PUBLIC_ 前缀）
SUPABASE_URL=https://ifirvlbeaookzhvvcdzs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 会话 JWT 签名密钥（至少 32 字节；不足视为未配置并拒绝）
# 生成示例：openssl rand -base64 48
SESSION_SECRET=

# WebAuthn / Passkey
WEBAUTHN_RP_ID=desk.nopaiseh.com
WEBAUTHN_RP_NAME=玄机阁
WEBAUTHN_ORIGIN=https://desk.nopaiseh.com

# 站点显示名（登录页可展示，勿写其它敏感文案）
SITE_NAME=玄机阁

# 应用层字段加密（items.title / body / source_url；AES-256-GCM + AAD）
# 生成：openssl rand -base64 32（须严格 base64，解码恰好 32 字节）
# 任选一种配置（见 docs/architecture.md「字段加密」）：
# 1) 单密钥（默认版本 v1）
FIELD_ENCRYPTION_KEY=
# 2) 版本化密钥环 + 当前版本（推荐轮换时使用）
# FIELD_ENCRYPTION_KEY_V1=
# FIELD_ENCRYPTION_KEY_V2=
# FIELD_ENCRYPTION_KEY_CURRENT=1
# 3) JSON 密钥图
# FIELD_ENCRYPTION_KEYS={"1":"<base64 32 bytes>","2":"<base64 32 bytes>"}
# FIELD_ENCRYPTION_KEY_CURRENT=2
# 回填完成后开启：拒绝遗留明文 / 无 AAD 密文 / 旧版 SHA content_hash
# FIELD_ENCRYPTION_STRICT=1

# content_hash = HMAC-SHA256（与字段加密密钥分离；同样 base64 32 字节）
# 生成：openssl rand -base64 32
CONTENT_HASH_KEY=
