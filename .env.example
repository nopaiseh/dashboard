# Supabase（服务器端专用；切勿加 NEXT_PUBLIC_ 前缀，浏览器不得持有任何数据库密钥）
SUPABASE_URL=https://ifirvlbeaookzhvvcdzs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 会话 JWT 签名密钥（至少 32 字节；不足视为未配置并拒绝）
# 生成示例：openssl rand -base64 48
SESSION_SECRET=

# 首次 passkey 注册启动令牌（明文只放环境变量；库中只记是否已消耗）
# 要求：至少 32 字节随机；不足视为未配置并拒绝。生成示例：
#   openssl rand -base64 48
# 比对：服务端先 sha256 再 timingSafeEqual。一旦 webauthn_credentials 有任何凭据，bootstrap 一律失效。
BOOTSTRAP_TOKEN=

# WebAuthn / Passkey
WEBAUTHN_RP_ID=desk.nopaiseh.com
WEBAUTHN_RP_NAME=玄机阁
WEBAUTHN_ORIGIN=https://desk.nopaiseh.com

# 站点显示名（登录页可展示，勿写其它敏感文案）
SITE_NAME=玄机阁
