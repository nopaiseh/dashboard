# Supabase（服务器端专用；切勿加 NEXT_PUBLIC_ 前缀到 service role）
SUPABASE_URL=https://ifirvlbeaookzhvvcdzs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Auth OTP（仅首次登记魔法链接：signInWithOtp / verifyOtp）
# 可用 SUPABASE_ANON_KEY，或 NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 会话 JWT 签名密钥（至少 32 字节；不足视为未配置并拒绝）
# 亦用于签发短时 setup-grant cookie。生成示例：openssl rand -base64 48
SESSION_SECRET=

# 首次 passkey 登记：唯一允许接收魔法链接的邮箱（服务器专用，勿硬编码到仓库）
# 须与 Supabase Auth 中已存在的用户一致（禁止公开注册 + shouldCreateUser: false）
OWNER_EMAIL=

# WebAuthn / Passkey
WEBAUTHN_RP_ID=desk.nopaiseh.com
WEBAUTHN_RP_NAME=玄机阁
WEBAUTHN_ORIGIN=https://desk.nopaiseh.com

# 站点显示名（登录页可展示，勿写其它敏感文案）
SITE_NAME=玄机阁
